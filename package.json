{
  "name": "flare-redact",
  "version": "1.5.1",
  "description": "Zero-dependency secret and PII redaction for any SDK, logs, HTTP, LLM prompts, and MCP tools — with a Docker sidecar gateway and Python, Go and Rust SDKs.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stream": {
      "types": "./dist/stream.d.ts",
      "default": "./dist/stream.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "default": "./dist/llm.js"
    },
    "./ml": {
      "types": "./dist/ml.d.ts",
      "default": "./dist/ml.js"
    },
    "./tool": {
      "types": "./dist/tool.d.ts",
      "default": "./dist/tool.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./pino": {
      "types": "./dist/pino.d.ts",
      "default": "./dist/pino.js"
    },
    "./winston": {
      "types": "./dist/winston.d.ts",
      "default": "./dist/winston.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    },
    "./csv": {
      "types": "./dist/csv.d.ts",
      "default": "./dist/csv.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "default": "./dist/pack.js"
    },
    "./gateway": {
      "types": "./dist/gateway/index.d.ts",
      "default": "./dist/gateway/index.js"
    },
    "./spec/detectors.json": "./spec/detectors.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "flare-redact": "bin/flare-redact.mjs",
    "flare-gateway": "bin/flare-gateway.mjs"
  },
  "files": [
    "dist",
    "bin",
    "spec/SPEC.md",
    "spec/detectors.json",
    "spec/detectors.schema.json",
    "spec/conformance",
    "docker/Dockerfile",
    "docker/docker-compose.yml",
    "docker/flare-gateway.example.json",
    "bench/performance.mjs",
    "bench/adversarial-runtime.mjs",
    "bench/graph-vault.mjs",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test",
    "test:python": "PYTHONPATH=sdk/python/src python3 -m unittest discover -s sdk/python/tests -t sdk/python",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check",
    "spec:conformance": "npm run build && node scripts/build-conformance.mjs",
    "gateway": "npm run build && node bin/flare-gateway.mjs",
    "benchmark": "npm run build && node bench/performance.mjs",
    "benchmark:adversarial": "npm run build && node bench/adversarial-runtime.mjs",
    "prepublishOnly": "npm run build",
    "benchmark:graph": "npm run build && node bench/graph-vault.mjs",
    "build:playground": "npm run build && npx --yes esbuild dist/index.js --bundle --format=esm --minify --outfile=docs/playground/flare-redact.min.js"
  },
  "keywords": [
    "redact",
    "redaction",
    "redactor",
    "secrets",
    "secret",
    "secret-detection",
    "secret-scanning",
    "pii",
    "pii-redaction",
    "mask",
    "masking",
    "data-masking",
    "sanitize",
    "sanitization",
    "scrub",
    "anonymize",
    "pseudonymize",
    "obfuscate",
    "censor",
    "log",
    "logs",
    "logging",
    "logger",
    "log-redaction",
    "security",
    "privacy",
    "sensitive-data",
    "dlp",
    "gdpr",
    "pci",
    "pci-dss",
    "compliance",
    "api-key",
    "apikey",
    "token",
    "jwt",
    "credentials",
    "password",
    "redos",
    "zero-dependency",
    "typescript",
    "cli",
    "llm",
    "ai",
    "openai",
    "anthropic",
    "chatgpt",
    "claude",
    "prompt",
    "ai-privacy",
    "data-anonymization",
    "anonymization",
    "pseudonymization",
    "tokenization",
    "surrogate-data",
    "hmac",
    "aes-gcm",
    "i18n",
    "multi-language",
    "national-id",
    "iban",
    "gdpr-compliance",
    "middleware",
    "mcp",
    "ai-agents",
    "data-loss-prevention",
    "sdk"
  ],
  "author": "Umud Hasanli (https://github.com/umudhasanli)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flare-collection/flare-redact.git"
  },
  "homepage": "https://flare-collection.github.io/flare-redact/",
  "bugs": {
    "url": "https://github.com/flare-collection/flare-redact/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  }
}
