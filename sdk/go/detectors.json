      "pattern": "[A-Za-z0-9._%+-]{1,64}[ \\t\\n\\x0B\\f\\r]*(?:\\[at\\]|\\(at\\))[ \\t\\n\\x0B\\f\\r]*[A-Za-z0-9-]{1,63}(?:[ \\t\\n\\x0B\\f\\r]*(?:\\[dot\\]|\\(dot\\))[ \\t\\n\\x0B\\f\\r]*[A-Za-z0-9-]{1,63}){1,4}",
      "flags": "i",
      "boundary": {
