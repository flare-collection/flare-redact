{
  "$schema": "./detectors.schema.json",
  "spec": "FRS-1",
  "id": "flare-redact/core",
  "version": "1.5.0",
  "title": "flare-redact core detector pack",
  "description": "The portable profile of the flare-redact detector set. Every pattern is written in the FRS-1 regular-expression subset so the JavaScript, Python, Go and Rust engines compile it to the same automaton and produce byte-identical output. See spec/SPEC.md.",
  "license": "MIT",
  "confidenceModel": {
    "version": 1,
    "features": [
      "log2Len",
      "entropy",
      "fracLower",
      "fracUpper",
      "fracDigit",
      "fracSymbol",
      "fracHex",
      "vowelFrac",
      "classTransitionRate",
      "hasMixedClasses",
      "maxRunFrac",
      "structuredHexId",
      "ctxSecret",
      "ctxBenign"
    ],
    "weights": [
      2.712748,
      3.920866,
      -5.874776,
      5.484371,
      1.346649,
      -9.662469,
      -0.058102,
      8.500786,
      2.714721,
      -0.676255,
      -3.0573,
      -6.969532,
      5.6429,
      -5.446436
    ],
    "bias": -29.559382
  },
  "detectors": [
    {
      "id": "private_key",
      "label": "Private key",
      "why": "A PEM private key is a full cryptographic identity — whoever holds it is you.",
      "pattern": "-----BEGIN (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----{{ANY}}*?-----END (?:RSA |EC |DSA |OPENSSH |PGP |ENCRYPTED )?PRIVATE KEY-----",
      "prefilter": [
        "-----begin"
      ],
      "mask": {
        "type": "fixed",
        "text": "[REDACTED PRIVATE KEY]"
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "aws_access_key",
      "label": "AWS access key ID",
      "why": "Pairs with a secret key to control cloud resources and billing.",
      "pattern": "(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA)(?:[ \\t-]?[A-Z0-9]){16}",
      "boundary": {
        "before": "word",
        "after": "word"
      },
      "validators": [
        {
          "name": "normalized_match",
          "strip": "[ \\t-]",
          "pattern": "(?:AKIA|ASIA|AGPA|AIDA|AROA|ANPA|ANVA)[A-Z0-9]{16}"
        }
      ],
      "mask": {
        "type": "keepPrefix",
        "n": 4
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.99
    },
    {
      "id": "aws_secret_key",
      "label": "AWS secret access key",
      "why": "The signing half of an AWS credential pair — full API access.",
      "pattern": "(?:aws)?_?secret_?(?:access_?)?key[\"' \\t\\n\\x0B\\f\\r]*[:=][ \\t\\n\\x0B\\f\\r]*[\"']?([A-Za-z0-9/+]{40})",
      "flags": "i",
      "capture": 1,
      "boundary": {
        "after": "base64"
      },
      "prefilter": [
        "secret"
      ],
      "mask": {
        "type": "fixed",
        "text": "***"
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92,
      "priority": 1
    },
    {
      "id": "github_token",
      "label": "GitHub token",
      "why": "Grants access to repositories and account actions.",
      "pattern": "(?:gh[posur]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{82})",
      "boundary": {
        "before": "word",
        "after": "word"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 4
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "gitlab_token",
      "label": "GitLab token",
      "why": "A GitLab personal access token grants API and repo access.",
      "pattern": "glpat-[A-Za-z0-9_-]{20}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 6
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "slack_token",
      "label": "Slack token",
      "why": "Lets the holder read and post as your workspace app.",
      "pattern": "xox[baprs]-[A-Za-z0-9-]{10,64}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 5
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "stripe_key",
      "label": "Stripe secret key",
      "why": "A live secret or restricted key can move real money.",
      "pattern": "(?:sk|rk)_(?:live|test)_[A-Za-z0-9]{16,64}",
      "boundary": {
        "before": "word",
        "after": "word"
      },
      "mask": {
        "type": "keepThroughSeparator",
        "separator": "_",
        "count": 2
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "anthropic_key",
      "label": "Anthropic API key",
      "why": "Bills against your Anthropic account and reaches your models and data.",
      "pattern": "sk-ant-[A-Za-z0-9_-]{24,160}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 7
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "openai_key",
      "label": "OpenAI API key",
      "why": "Bills against your account and reaches your models and data.",
      "pattern": "sk-(?:proj-)?[A-Za-z0-9_-]{20,64}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "reject": [
        "sk-(?:ant|or)-"
      ],
      "mask": {
        "type": "keepPrefix",
        "n": 3
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "google_api_key",
      "label": "Google API key",
      "why": "Grants access to enabled Google Cloud APIs on your project.",
      "pattern": "AIza[0-9A-Za-z_-]{35}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 4
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "sendgrid_key",
      "label": "SendGrid API key",
      "why": "Can send mail as your domain and read templates.",
      "pattern": "SG\\.[A-Za-z0-9_-]{16,32}\\.[A-Za-z0-9_-]{16,64}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 3
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "twilio_key",
      "label": "Twilio SID / key",
      "why": "Can send messages and place calls billed to your account.",
      "pattern": "(?:AC|SK)[a-f0-9]{32}",
      "boundary": {
        "before": "word",
        "after": "word"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 4
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "npm_token",
      "label": "npm token",
      "why": "Can publish packages to your npm account.",
      "pattern": "npm_[A-Za-z0-9]{36}",
      "boundary": {
        "before": "word",
        "after": "word"
      },
      "mask": {
        "type": "keepPrefix",
        "n": 4
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "jwt",
      "label": "JSON Web Token",
      "why": "Often a live session or bearer credential — decode it and you may be signed in.",
      "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{4,}",
      "boundary": {
        "before": "word",
        "after": "word_dash"
      },
      "prefilter": [
        "eyj"
      ],
      "mask": {
        "type": "fixed",
        "text": "[REDACTED JWT]"
      },
      "default": true,
      "risk": "high",
      "confidence": 0.92
    },
    {
      "id": "bearer_token",
      "label": "Bearer token",
      "why": "A bearer token in an Authorization header is a live credential.",
      "pattern": "Bearer[ \\t\\n\\x0B\\f\\r]+[A-Za-z0-9._~+/-]{8,}={0,2}",
      "boundary": {
        "before": "word"
      },
      "prefilter": [
        "bearer"
      ],
      "mask": {
        "type": "fixed",
        "text": "Bearer ***"
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "basic_auth",
      "label": "Basic auth header",
      "why": "Base64 in a Basic header decodes straight back to user:password.",
      "pattern": "Basic[ \\t\\n\\x0B\\f\\r]+[A-Za-z0-9+/]{8,}={0,2}",
      "boundary": {
        "before": "word"
      },
      "prefilter": [
        "basic"
      ],
      "mask": {
        "type": "fixed",
        "text": "Basic ***"
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "url_credentials",
      "label": "Credentials in URL",
      "why": "A username:password baked into a connection string leaks the password.",
      "pattern": "[a-zA-Z][a-zA-Z0-9+.-]*://[^:@ \\t\\n\\x0B\\f\\r/]+:[^@ \\t\\n\\x0B\\f\\r/]+@",
      "boundary": {
        "before": "word"
      },
      "prefilter": [
        "://"
      ],
      "mask": {
        "type": "replace",
        "pattern": "([a-zA-Z][a-zA-Z0-9+.-]*://[^:@ \\t\\n\\x0B\\f\\r/]+:)[^@ \\t\\n\\x0B\\f\\r/]+(@)",
        "replacement": "$1***$2"
      },
      "default": true,
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "generic_assignment",
      "label": "Assigned secret",
      "why": "A value assigned to a sensitive-looking field name (password=…, 密码: …) in any language.",
      "pattern": "(?:zugangsschlüssel|client_secret|секретныйключ|parola_chiave|mot_de_passe|chavesecreta|gizlianahtar|parolachiave|private_key|credentials|credenziale|access_key|access-key|secret_key|privatekey|credential|auth_token|passphrase|contraseña|contrasena|credencial|كلمةالمرور|motdepasse|clésecrète|schluessel|wachtwoord|kata_sandi|accesskey|motdepass|geheimnis|schlüssel|katasandi|password|كلمةالسر|passwort|kennwort|کلمهعبور|mat_khau|รหัสผ่าน|api_key|api-key|पासवर्ड|secreto|segredo|anahtar|segreto|رمزعبور|گذرواژه|محرمانه|таємний|sleutel|matkhau|rahasia|ความลับ|κωδικός|μυστικό|passwd|secret|apikey|пароль|секрет|geheim|parola|chiave|poufne|κλειδί|parolă|token|गुप्त|कुंजी|clave|مفتاح|senha|chave|токен|パスワード|şifre|sifre|gizli|hasło|haslo|tajne|klucz|bimat|sandi|kunci|סיסמה|şifrə|parol|məxfi|cheie|टोकन|clef|ключ|トークン|暗証番号|비밀번호|کلید|khoa|מפתח|açar|pwd|رمز|سري|clé|合言葉|비밀키|סוד|密码|密碼|秘密|令牌|密钥|私钥|口令|سر|암호|비밀|토큰)[\"' \\t\\n\\x0B\\f\\r]*[:=][ \\t\\n\\x0B\\f\\r]*[\"']?([^ \\t\\n\\x0B\\f\\r\"',;]{4,})[\"']?",
      "flags": "i",
      "mask": {
        "type": "replace",
        "pattern": "({{ANY}}*[:=][ \\t\\n\\x0B\\f\\r]*[\"']?)[^ \\t\\n\\x0B\\f\\r\"',;]{4,}([\"']?)",
        "replacement": "$1***$2"
      },
      "default": true,
      "tags": [
        "secret"
      ],
      "risk": "critical",
      "confidence": 0.92
    },
    {
      "id": "email",
      "label": "Email address",
      "why": "Personal data that usually does not belong in logs.",
      "pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,24}",
