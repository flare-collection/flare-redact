<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.flare-collection</groupId>
    <artifactId>flare-redact-parent</artifactId>
    <version>1.13.1</version>
  </parent>

  <artifactId>flare-redact-logback</artifactId>
  <packaging>jar</packaging>

  <name>flare-redact-logback</name>
  <description>Logback integration for flare-redact: a %redact() pattern converter and an encoder that redacts whatever another encoder writes.</description>
  <url>https://flare-collection.github.io/flare-redact/</url>

  <dependencies>
    <dependency>
      <groupId>io.github.flare-collection</groupId>
      <artifactId>flare-redact</artifactId>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <version>${logback.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifestEntries>
              <Automatic-Module-Name>io.github.flarecollection.redact.logback</Automatic-Module-Name>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
